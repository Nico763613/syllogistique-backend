// LOGI-FLEET MANAGER — Schéma de base de données
// PostgreSQL + Prisma

generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// ORGANISATION / MULTI-SITE
// ============================================================

model Organization {
  id        String   @id @default(uuid())
  name      String
  address   String?
  phone     String?
  email     String?
  logoUrl   String?  @map("logo_url")
  currency  String   @default("GNF")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  sites     Site[]
  users     User[]
  settings  Setting[]

  @@map("organizations")
}

model Site {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  name           String
  location       String?
  description    String?
  status         SiteStatus @default(ACTIVE)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization   Organization @relation(fields: [organizationId], references: [id])
  vehicles       Vehicle[]
  drivers        Driver[]
  trips          Trip[]
  fuelTransactions FuelTransaction[]
  inventoryItems InventoryItem[]
  stockMovements StockMovement[]
  attendances    DriverAttendance[]
  users          User[]
  customers      Customer[]
  purchaseOrders PurchaseOrder[]
  salesOrders    SalesOrder[]
  purchaseInvoices PurchaseInvoice[]
  salesInvoices  SalesInvoice[]


  stockLocations   StockLocation[]
  stockLots        StockLot[]
  goodsReceipts    GoodsReceipt[]
  transfersFrom    StockTransfer[] @relation("TransferFromSite")
  transfersTo      StockTransfer[] @relation("TransferToSite")
  cashSessions     CashSession[]
  salesReturns     SalesReturn[]
  payments         Payment[]
  notifications    Notification[]
  hseIncidents     HseIncident[]
  hseCorrectiveActions HseCorrectiveAction[]
  hseToolboxTalks  HseToolboxTalk[]
  hseInspections   HseInspection[]
  ppeIssuances     PpeIssuance[]
  hseWorkedHours   HseWorkedHours[]
  @@index([organizationId])
  @@map("sites")
}

enum SiteStatus {
  ACTIVE
  INACTIVE
}

// ============================================================
// UTILISATEURS / RÔLES / PERMISSIONS
// ============================================================

model Role {
  id          String   @id @default(uuid())
  name        RoleName @unique
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  users       User[]
  permissions RolePermission[]

  @@map("roles")
}

enum RoleName {
  SUPER_ADMIN
  ADMIN_LOGISTIQUE
  GESTIONNAIRE_FLOTTE
  MAGASINIER
  CHAUFFEUR
  LECTEUR
  RESPONSABLE_COMMERCIAL
  CAISSIER
  GESTIONNAIRE_HSE
  AGENT_HSE
}

model Permission {
  id    String @id @default(uuid())
  code  String @unique // ex: "vehicles.create", "stock.out"
  label String

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String @map("role_id")
  permissionId String @map("permission_id")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model User {
  id             String    @id @default(uuid())
  organizationId String    @map("organization_id")
  siteId         String?   @map("site_id")
  roleId         String    @map("role_id")
  firstName      String    @map("first_name")
  lastName       String    @map("last_name")
  email          String    @unique
  phone          String?
  // Département : LOGISTIQUE, CARBURANT, STOCK ou RH (vide = pas de restriction de département)
  department     String?
  passwordHash   String    @map("password_hash")
  status         UserStatus @default(ACTIVE)
  refreshTokenHash String? @map("refresh_token_hash")
  lastLoginAt    DateTime? @map("last_login_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  organization   Organization @relation(fields: [organizationId], references: [id])
  site           Site?        @relation(fields: [siteId], references: [id])
  role           Role         @relation(fields: [roleId], references: [id])
  auditLogs      AuditLog[]
  stockMovements StockMovement[]
  trips          Trip[]        @relation("TripCreatedBy")
  attendancesMarked DriverAttendance[] @relation("AttendanceCreatedBy")


  cashSessions     CashSession[]
  notifications    Notification[]
  hseCorrectiveActions HseCorrectiveAction[] @relation("ActionResponsible")
  hseToolboxTalks  HseToolboxTalk[] @relation("TalkFacilitator")
  hseToolboxAttendees HseToolboxAttendee[]
  hseInspections   HseInspection[] @relation("InspectionInspector")
  hseIncidentPersons HseIncidentPerson[]
  ppeIssuances     PpeIssuance[]
  hseTrainings     HseTraining[]
  @@index([organizationId])
  @@index([roleId])
  @@map("users")
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DISABLED
}

// ============================================================
// CHAUFFEURS
// ============================================================

model Driver {
  id                String    @id @default(uuid())
  siteId            String    @map("site_id")
  firstName         String    @map("first_name")
  lastName          String    @map("last_name")
  phone             String?
  licenseNumber     String?   @map("license_number")
  licenseCategory   String?   @map("license_category")
  licenseExpiryDate DateTime? @map("license_expiry_date")
  status            DriverStatus @default(ACTIVE)
  photoUrl          String?   @map("photo_url")
  observations      String?
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  deletedAt         DateTime? @map("deleted_at")

  site              Site      @relation(fields: [siteId], references: [id])
  vehicles          Vehicle[]
  attendances       DriverAttendance[]
  trips             Trip[]
  fuelTransactions  FuelTransaction[]


  hseIncidentPersons HseIncidentPerson[]
  hseToolboxAttendees HseToolboxAttendee[]
  ppeIssuances     PpeIssuance[]
  hseTrainings     HseTraining[]
  // Compte utilisateur (rôle CHAUFFEUR) lié à ce profil chauffeur : permet l'application mobile
  userId           String?   @unique @map("user_id")
  @@index([siteId])
  @@map("drivers")
}

enum DriverStatus {
  ACTIVE
  SUSPENDED
  INACTIVE
}

model DriverAttendance {
  id             String   @id @default(uuid())
  driverId       String   @map("driver_id")
  siteId         String   @map("site_id")
  date           DateTime @db.Date
  status         AttendanceStatus
  absenceReason  String?  @map("absence_reason")
  checkIn        DateTime? @map("check_in")
  checkOut       DateTime? @map("check_out")
  createdById    String   @map("created_by")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  driver         Driver   @relation(fields: [driverId], references: [id])
  site           Site     @relation(fields: [siteId], references: [id])
  createdBy      User     @relation("AttendanceCreatedBy", fields: [createdById], references: [id])

  @@unique([driverId, date])
  @@index([siteId, date])
  @@map("driver_attendance")
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  SICK
  LEAVE
  PERMISSION
  REST
  OTHER
}

// ============================================================
// VÉHICULES (CAMIONS + VÉHICULES DE SERVICE — table unifiée)
// ============================================================

model Vehicle {
  id                 String      @id @default(uuid())
  siteId             String      @map("site_id")
  vehicleType        VehicleType @map("vehicle_type")
  internalNumber     String      @map("internal_number")
  registrationNumber String      @map("registration_number")
  brand              String?
  model              String?
  year               Int?
  capacity           String?
  currentMileage     Int         @default(0) @map("current_mileage")
  status             VehicleStatus @default(AVAILABLE)
  assignedDriverId   String?     @map("assigned_driver_id")
  photoUrl           String?     @map("photo_url")
  observations       String?
  registrationType   String      @default("NORMALE") @map("registration_type") // NORMALE | IT (Immatriculation Temporaire)
  itExpiryDate       DateTime?   @map("it_expiry_date") // fin de validité de la plaque IT
  createdAt          DateTime    @default(now()) @map("created_at")
  updatedAt          DateTime    @updatedAt @map("updated_at")
  deletedAt          DateTime?   @map("deleted_at")

  site               Site        @relation(fields: [siteId], references: [id])
  assignedDriver     Driver?     @relation(fields: [assignedDriverId], references: [id])
  trips              Trip[]
  fuelTransactions   FuelTransaction[]
  maintenance        Maintenance[]
  expenses           Expense[]
  documents          Document[]
  stockMovements     StockMovement[]
  downtimes          VehicleDowntime[]


  currentHours       Decimal?    @map("current_hours") @db.Decimal(10, 1) // compteur horaire (engins / camions de site)
  referenceConsumption Decimal?  @map("reference_consumption") @db.Decimal(6, 2) // L/100 km ou L/h constructeur
  purchaseOrders     PurchaseOrder[]
  hseIncidents       HseIncident[]
  hseInspections     HseInspection[]
  @@unique([siteId, registrationNumber])
  @@index([siteId, vehicleType])
  @@map("vehicles")
}

enum VehicleType {
  TRUCK
  SERVICE_VEHICLE
}

enum VehicleStatus {
  AVAILABLE
  ON_MISSION
  MAINTENANCE
  IMMOBILIZED
  OUT_OF_SERVICE
}

// ============================================================
// MISSIONS / FICHE DE BORD
// ============================================================

model Trip {
  id            String   @id @default(uuid())
  vehicleId     String   @map("vehicle_id")
  driverId      String   @map("driver_id")
  siteId        String   @map("site_id")
  tripDate      DateTime @db.Date @map("trip_date")
  startTime     DateTime @map("start_time")
  endTime       DateTime? @map("end_time")
  startMileage  Int      @map("start_mileage")
  endMileage    Int?     @map("end_mileage")
  distance      Int?     // calculé automatiquement = endMileage - startMileage
  destination   String?
  purpose       String?
  passengerName String?  @map("passenger_name")
  observations  String?
  createdById   String   @map("created_by")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  vehicle       Vehicle  @relation(fields: [vehicleId], references: [id])
  driver        Driver   @relation(fields: [driverId], references: [id])
  site          Site     @relation(fields: [siteId], references: [id])
  createdBy     User     @relation("TripCreatedBy", fields: [createdById], references: [id])


  status        String   @default("PLANNED") // PLANNED | IN_PROGRESS | COMPLETED | CANCELLED
  endCondition  String?  @map("end_condition")
  // Application chauffeur : retard prévu, position GPS, livraison signée
  scheduledArrival DateTime? @map("scheduled_arrival")
  delayReason   String?  @map("delay_reason")
  recipientName String?  @map("recipient_name")
  signatureData String?  @map("signature_data")
  startLat      Float?   @map("start_lat")
  startLng      Float?   @map("start_lng")
  endLat        Float?   @map("end_lat")
  endLng        Float?   @map("end_lng")
  // Fiche chauffeur : nature, régions, chargement, voyages, état avant départ, maintenance
  purposeType   String?  @map("purpose_type") // MISSION | AUTRE | TRANSPORT
  regions       String[] @default([])
  cargo         String?
  tripsCount    Int?     @map("trips_count")
  preCondition  String?  @map("pre_condition") // RAS | ANOMALIE
  preAnomalies  String?  @map("pre_anomalies")
  maintenanceNeeded Boolean? @map("maintenance_needed")
  maintenanceReason String?  @map("maintenance_reason")
  @@index([siteId, tripDate])
  @@index([vehicleId])
  @@map("trips")
}

// ============================================================
// CARBURANT
// ============================================================

model FuelTransaction {
  id               String   @id @default(uuid())
  vehicleId        String   @map("vehicle_id")
  driverId         String?  @map("driver_id")
  siteId           String   @map("site_id")
  transactionDate  DateTime @map("transaction_date")
  mileage          Int
  quantityLiters   Decimal  @map("quantity_liters") @db.Decimal(10, 2)
  pricePerLiter    Decimal  @map("price_per_liter") @db.Decimal(10, 2)
  totalCost        Decimal  @map("total_cost") @db.Decimal(14, 2) // calculé = quantity * price
  station          String?
  receiptNumber    String?  @map("receipt_number")
  receiptImageUrl  String?  @map("receipt_image_url")
  observations     String?
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  vehicle          Vehicle  @relation(fields: [vehicleId], references: [id])
  driver           Driver?  @relation(fields: [driverId], references: [id])
  site             Site     @relation(fields: [siteId], references: [id])


  source           String   @default("STATION") // STATION | TANK
  hours            Decimal? @db.Decimal(10, 1)
  tripId           String?  @map("trip_id")
  clientOpId       String?  @unique @map("client_op_id")
  @@index([siteId, transactionDate])
  @@index([vehicleId])
  @@map("fuel_transactions")
}

// ============================================================
// MAINTENANCE
// ============================================================

model MaintenanceType {
  id    String @id @default(uuid())
  code  String @unique // VIDANGE, REVISION, PNEUS, FREINS, BATTERIE, ...
  label String

  maintenances Maintenance[]

  @@map("maintenance_types")
}

model Maintenance {
  id                String   @id @default(uuid())
  vehicleId         String   @map("vehicle_id")
  maintenanceTypeId String   @map("maintenance_type_id")
  maintenanceDate   DateTime @map("maintenance_date")
  mileage           Int?
  description       String?
  supplierId        String?  @map("supplier_id")
  cost              Decimal? @db.Decimal(14, 2)
  nextDate          DateTime? @map("next_date")
  nextMileage       Int?     @map("next_mileage")
  invoiceNumber     String?  @map("invoice_number")
  invoiceUrl        String?  @map("invoice_url")
  status            MaintenanceStatus @default(COMPLETED)
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  vehicle           Vehicle  @relation(fields: [vehicleId], references: [id])
  maintenanceType   MaintenanceType @relation(fields: [maintenanceTypeId], references: [id])
  supplier          Supplier? @relation(fields: [supplierId], references: [id])


  kind              String   @default("CORRECTIVE") // PREVENTIVE | CORRECTIVE
  partsCost         Decimal  @default(0) @map("parts_cost") @db.Decimal(14, 0)
  laborCost         Decimal  @default(0) @map("labor_cost") @db.Decimal(14, 0)
  nextHours         Decimal? @map("next_hours") @db.Decimal(10, 1)
  @@index([vehicleId])
  @@map("maintenance")
}

enum MaintenanceStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  OVERDUE
}

// ============================================================
// STOCKS
// ============================================================

model StockCategory {
  id    String @id @default(uuid())
  name  String @unique

  items InventoryItem[]

  @@map("stock_categories")
}

model InventoryItem {
  id               String   @id @default(uuid())
  siteId           String   @map("site_id")
  categoryId       String?  @map("category_id")
  sku              String
  name             String
  description      String?
  brand            String?
  reference        String?
  unit             String   @default("unité")
  currentQuantity  Decimal  @default(0) @map("current_quantity") @db.Decimal(12, 2)
  minimumQuantity  Decimal  @default(0) @map("minimum_quantity") @db.Decimal(12, 2)
  maximumQuantity  Decimal? @map("maximum_quantity") @db.Decimal(12, 2)
  unitPrice        Decimal? @map("unit_price") @db.Decimal(14, 2)
  location         String?
  qrCode           String?  @map("qr_code")
  supplierId       String?  @map("supplier_id")
  photoUrl         String?  @map("photo_url")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  site             Site     @relation(fields: [siteId], references: [id])
  category         StockCategory? @relation(fields: [categoryId], references: [id])
  supplier         Supplier? @relation(fields: [supplierId], references: [id])
  movements        StockMovement[]
  purchaseOrderLines PurchaseOrderLine[]
  salesOrderLines  SalesOrderLine[]
  countLines       InventoryCountLine[]


  locationId       String?  @map("location_id")
  valuationMethod  String   @default("FIFO") @map("valuation_method") // FIFO | LIFO | CMUP
  reorderPoint     Decimal? @map("reorder_point") @db.Decimal(14, 3)
  taxRate          Decimal? @map("tax_rate") @db.Decimal(5, 2)
  salePrice        Decimal? @map("sale_price") @db.Decimal(14, 2)
  hasExpiry        Boolean  @default(false) @map("has_expiry")
  isHazardous      Boolean  @default(false) @map("is_hazardous")
  sdsUrl           String?  @map("sds_url") // fiche de données de sécurité
  deletedAt        DateTime? @map("deleted_at")

  stockLocation    StockLocation? @relation(fields: [locationId], references: [id])
  lots             StockLot[]
  goodsReceiptLines GoodsReceiptLine[]
  transferLines    StockTransferLine[]
  salesReturnLines SalesReturnLine[]
  hseIncidents     HseIncident[]
  @@unique([siteId, sku])
  @@index([siteId])
  @@map("stock_items")
}

// Inventaire physique : comptage réel par site / entrepôt, écarts par rapport au stock théorique
model InventoryCount {
  id            String   @id @default(uuid())
  siteId        String   @map("site_id")
  location      String?  // entrepôt / emplacement compté (vide = tout le site)
  status        String   @default("OPEN") // OPEN | VALIDATED | CANCELLED
  note          String?
  createdById   String   @map("created_by")
  validatedById String?  @map("validated_by")
  createdAt     DateTime @default(now()) @map("created_at")
  validatedAt   DateTime? @map("validated_at")

  lines         InventoryCountLine[]

  @@index([siteId, createdAt])
  @@map("inventory_counts")
}

model InventoryCountLine {
  id               String   @id @default(uuid())
  countId          String   @map("count_id")
  itemId           String   @map("item_id")
  expectedQuantity Decimal  @map("expected_quantity") @db.Decimal(12, 2)
  countedQuantity  Decimal? @map("counted_quantity") @db.Decimal(12, 2)
  note             String?

  count            InventoryCount @relation(fields: [countId], references: [id], onDelete: Cascade)
  item             InventoryItem  @relation(fields: [itemId], references: [id])


  unitCost         Decimal? @map("unit_cost") @db.Decimal(14, 2)
  @@unique([countId, itemId])
  @@map("inventory_count_lines")
}

model StockMovement {
  id            String   @id @default(uuid())
  itemId        String   @map("item_id")
  siteId        String   @map("site_id")
  movementType  StockMovementType @map("movement_type")
  quantity      Decimal  @db.Decimal(12, 2)
  vehicleId     String?  @map("vehicle_id")
  supplierId    String?  @map("supplier_id")
  reason        String?
  reference     String?
  unitPrice     Decimal? @map("unit_price") @db.Decimal(14, 2)
  totalValue    Decimal? @map("total_value") @db.Decimal(14, 2)
  createdById   String   @map("created_by")
  createdAt     DateTime @default(now()) @map("created_at")

  item          InventoryItem @relation(fields: [itemId], references: [id])
  site          Site     @relation(fields: [siteId], references: [id])
  vehicle       Vehicle? @relation(fields: [vehicleId], references: [id])
  supplier      Supplier? @relation(fields: [supplierId], references: [id])
  createdBy     User     @relation(fields: [createdById], references: [id])


  lotId         String?  @map("lot_id")
  fromLocationId String? @map("from_location_id")
  toLocationId  String?  @map("to_location_id")
  transferId    String?  @map("transfer_id")
  reasonCode    String?  @map("reason_code") // RECEIPT, CONSUMPTION, SALE, RETURN, LOSS, BREAKAGE, DONATION, SCRAP, COUNT_GAP
  approvedBy    String?  @map("approved_by")
  clientOpId    String?  @unique @map("client_op_id") // idempotence hors-ligne

  lot           StockLot? @relation(fields: [lotId], references: [id])
  fromLocation  StockLocation? @relation("MovementFromLocation", fields: [fromLocationId], references: [id])
  toLocation    StockLocation? @relation("MovementToLocation", fields: [toLocationId], references: [id])
  transfer      StockTransfer? @relation(fields: [transferId], references: [id])
  @@index([itemId])
  @@index([siteId, createdAt])
  @@map("stock_movements")
}

enum StockMovementType {
  IN
  OUT
  ADJUSTMENT
  TRANSFER
  RETURN
}

// ============================================================
// FOURNISSEURS
// ============================================================

model Supplier {
  id           String   @id @default(uuid())
  name         String
  contactName  String?  @map("contact_name")
  phone        String?
  email        String?
  address      String?
  productsSupplied String? @map("products_supplied")
  observations String?
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  inventoryItems InventoryItem[]
  stockMovements StockMovement[]
  maintenances   Maintenance[]
  purchaseOrders PurchaseOrder[]
  purchaseInvoices PurchaseInvoice[]


  contractualLeadDays Int?  @map("contractual_lead_days")
  paymentTermDays     Int?  @map("payment_term_days")
  @@map("suppliers")
}

// ============================================================
// DÉPENSES / DOCUMENTS
// ============================================================

model Expense {
  id           String   @id @default(uuid())
  vehicleId    String?  @map("vehicle_id")
  category     String   // FUEL, MAINTENANCE, PARTS, TIRES, OTHER
  amount       Decimal  @db.Decimal(14, 2)
  expenseDate  DateTime @map("expense_date")
  description  String?
  createdAt    DateTime @default(now()) @map("created_at")

  vehicle      Vehicle? @relation(fields: [vehicleId], references: [id])

  @@map("expenses")
}

model Document {
  id           String   @id @default(uuid())
  vehicleId    String   @map("vehicle_id")
  type         String   // CARTE_GRISE, ASSURANCE, VISITE_TECHNIQUE, PERMIS, CONTRAT, FACTURE, AUTRE
  fileUrl      String   @map("file_url")
  expiryDate   DateTime? @map("expiry_date")
  createdAt    DateTime @default(now()) @map("created_at")

  vehicle      Vehicle  @relation(fields: [vehicleId], references: [id])

  @@map("documents")
}

// ============================================================
// NOTIFICATIONS
// ============================================================

model Notification {
  id        String   @id @default(uuid())
  title     String
  message   String
  severity  NotificationSeverity @default(INFO)
  entity    String?
  entityId  String?  @map("entity_id")
  isRead    Boolean  @default(false) @map("is_read")
  createdAt DateTime @default(now()) @map("created_at")


  siteId    String?  @map("site_id")
  userId    String?  @map("user_id") // destinataire (vide = par rôle)
  roleName  String?  @map("role_name")
  status    String   @default("NEW") // NEW | SEEN | HANDLED

  site      Site?    @relation(fields: [siteId], references: [id])
  user      User?    @relation(fields: [userId], references: [id])
  @@map("notifications")
}

enum NotificationSeverity {
  INFO
  WARNING
  CRITICAL
}

// ============================================================
// AUDIT
// ============================================================

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?  @map("user_id")
  action    String   // CREATE, UPDATE, DELETE
  entity    String
  entityId  String   @map("entity_id")
  oldValue  Json?    @map("old_value")
  newValue  Json?    @map("new_value")
  deviceId  String?  @map("device_id")
  ipAddress String?  @map("ip_address")
  createdAt DateTime @default(now()) @map("created_at")

  user      User?    @relation(fields: [userId], references: [id])

  @@index([entity, entityId])
  @@map("audit_logs")
}

// ============================================================
// SYNCHRONISATION OFFLINE
// ============================================================

model SyncQueueEntry {
  id          String   @id @default(uuid())
  entity      String
  entityId    String   @map("entity_id")
  operation   String   // CREATE, UPDATE, DELETE
  payload     Json
  deviceId    String?  @map("device_id")
  status      SyncStatus @default(PENDING)
  retryCount  Int      @default(0) @map("retry_count")
  lastError   String?  @map("last_error")
  createdAt   DateTime @default(now()) @map("created_at")
  syncedAt    DateTime? @map("synced_at")

  @@map("sync_queue")
}

enum SyncStatus {
  PENDING
  SYNCING
  SUCCESS
  FAILED
}

// ============================================================
// PARAMÈTRES
// ============================================================

model Setting {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  key            String
  value          String
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization   Organization @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, key])
  @@map("settings")
}

// ============================================================
// CLIENTS
// ============================================================

model Customer {
  id           String   @id @default(uuid())
  siteId       String   @map("site_id")
  name         String
  contactName  String?  @map("contact_name")
  phone        String?
  email        String?
  address      String?
  taxNumber    String?  @map("tax_number")
  creditLimit  Decimal? @map("credit_limit") @db.Decimal(14, 2)
  observations String?
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  site         Site     @relation(fields: [siteId], references: [id])
  salesOrders  SalesOrder[]
  salesInvoices SalesInvoice[]


  paymentTermDays Int? @map("payment_term_days")
  @@index([siteId])
  @@map("customers")
}

// ============================================================
// ACHATS — Bon de commande fournisseur → Réception → Facture → Paiement
// ============================================================

enum PurchaseOrderStatus {
  DRAFT
  CONFIRMED
  PARTIALLY_RECEIVED
  RECEIVED
  INVOICED
  CANCELLED
}

model PurchaseOrder {
  id           String   @id @default(uuid())
  siteId       String   @map("site_id")
  supplierId   String   @map("supplier_id")
  reference    String   @unique // ex: BC-2026-0001
  orderDate    DateTime @map("order_date")
  expectedDate DateTime? @map("expected_date")
  status       PurchaseOrderStatus @default(DRAFT)
  notes        String?
  attachmentUrl String? @map("attachment_url") // devis / bon de livraison scanné
  createdById  String   @map("created_by")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  site         Site     @relation(fields: [siteId], references: [id])
  supplier     Supplier @relation(fields: [supplierId], references: [id])
  lines        PurchaseOrderLine[]
  invoices     PurchaseInvoice[]


  freightCost  Decimal  @default(0) @map("freight_cost") @db.Decimal(14, 0)
  approvedBy   String?  @map("approved_by")
  approvedAt   DateTime? @map("approved_at")
  vehicleId    String?  @map("vehicle_id")
  category     String?  // STOCK | PARTS | FUEL

  vehicle      Vehicle? @relation(fields: [vehicleId], references: [id])
  goodsReceipts GoodsReceipt[]
  @@index([siteId, status])
  @@map("purchase_orders")
}

model PurchaseOrderLine {
  id              String   @id @default(uuid())
  purchaseOrderId String   @map("purchase_order_id")
  itemId          String   @map("item_id")
  quantityOrdered Decimal  @map("quantity_ordered") @db.Decimal(12, 2)
  quantityReceived Decimal @default(0) @map("quantity_received") @db.Decimal(12, 2)
  unitPrice       Decimal  @map("unit_price") @db.Decimal(14, 2)
  lineTotal       Decimal  @map("line_total") @db.Decimal(14, 2) // = quantityOrdered * unitPrice

  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  item            InventoryItem @relation(fields: [itemId], references: [id])


  goodsReceiptLines GoodsReceiptLine[]
  @@index([purchaseOrderId])
  @@map("purchase_order_lines")
}

enum InvoiceStatus {
  DRAFT
  UNPAID
  PARTIALLY_PAID
  PAID
  CANCELLED
}

enum PaymentTerm {
  CASH
  CREDIT
}

model PurchaseInvoice {
  id             String   @id @default(uuid())
  siteId         String   @map("site_id")
  supplierId     String   @map("supplier_id")
  purchaseOrderId String? @map("purchase_order_id")
  reference      String   @unique // ex: FA-2026-0001
  invoiceDate    DateTime @map("invoice_date")
  dueDate        DateTime? @map("due_date")
  paymentTerm    PaymentTerm @default(CASH) @map("payment_term")
  totalAmount    Decimal  @map("total_amount") @db.Decimal(14, 2)
  amountPaid     Decimal  @default(0) @map("amount_paid") @db.Decimal(14, 2)
  status         InvoiceStatus @default(UNPAID)
  attachmentUrl  String?  @map("attachment_url")
  createdById    String   @map("created_by")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  site           Site     @relation(fields: [siteId], references: [id])
  supplier       Supplier @relation(fields: [supplierId], references: [id])
  purchaseOrder  PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id])
  payments       Payment[]

  @@index([siteId, status])
  @@map("purchase_invoices")
}

// ============================================================
// VENTES — Devis → Bon de commande client → Livraison → Facture → Paiement
// ============================================================

enum SalesOrderStatus {
  QUOTE
  CONFIRMED
  PARTIALLY_DELIVERED
  DELIVERED
  INVOICED
  CANCELLED
}

model SalesOrder {
  id           String   @id @default(uuid())
  siteId       String   @map("site_id")
  customerId   String   @map("customer_id")
  reference    String   @unique // ex: DEV-2026-0001 ou BCC-2026-0001
  orderDate    DateTime @map("order_date")
  status       SalesOrderStatus @default(QUOTE)
  discountPercent Decimal @default(0) @map("discount_percent") @db.Decimal(5, 2)
  taxPercent   Decimal  @default(0) @map("tax_percent") @db.Decimal(5, 2)
  notes        String?
  createdById  String   @map("created_by")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  site         Site     @relation(fields: [siteId], references: [id])
  customer     Customer @relation(fields: [customerId], references: [id])
  lines        SalesOrderLine[]
  invoices     SalesInvoice[]


  saleType     String   @default("CASH") @map("sale_type") // CASH | CREDIT | INSTALLMENT | PROMO
  @@index([siteId, status])
  @@map("sales_orders")
}

model SalesOrderLine {
  id              String   @id @default(uuid())
  salesOrderId    String   @map("sales_order_id")
  itemId          String   @map("item_id")
  quantityOrdered Decimal  @map("quantity_ordered") @db.Decimal(12, 2)
  quantityDelivered Decimal @default(0) @map("quantity_delivered") @db.Decimal(12, 2)
  unitPrice       Decimal  @map("unit_price") @db.Decimal(14, 2)
  lineTotal       Decimal  @map("line_total") @db.Decimal(14, 2)

  salesOrder      SalesOrder @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  item            InventoryItem @relation(fields: [itemId], references: [id])


  discountPercent Decimal @default(0) @map("discount_percent") @db.Decimal(5, 2)
  taxPercent      Decimal @default(0) @map("tax_percent") @db.Decimal(5, 2)
  @@index([salesOrderId])
  @@map("sales_order_lines")
}

model SalesInvoice {
  id            String   @id @default(uuid())
  siteId        String   @map("site_id")
  customerId    String   @map("customer_id")
  salesOrderId  String?  @map("sales_order_id")
  reference     String   @unique // ex: FV-2026-0001
  invoiceDate   DateTime @map("invoice_date")
  dueDate       DateTime? @map("due_date")
  paymentTerm   PaymentTerm @default(CASH) @map("payment_term")
  subtotal      Decimal  @db.Decimal(14, 2)
  discountAmount Decimal @default(0) @map("discount_amount") @db.Decimal(14, 2)
  taxAmount     Decimal  @default(0) @map("tax_amount") @db.Decimal(14, 2)
  totalAmount   Decimal  @map("total_amount") @db.Decimal(14, 2)
  amountPaid    Decimal  @default(0) @map("amount_paid") @db.Decimal(14, 2)
  status        InvoiceStatus @default(UNPAID)
  createdById   String   @map("created_by")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  site          Site     @relation(fields: [siteId], references: [id])
  customer      Customer @relation(fields: [customerId], references: [id])
  salesOrder    SalesOrder? @relation(fields: [salesOrderId], references: [id])
  payments      Payment[]


  cashSessionId String?  @map("cash_session_id")
  cogsAmount    Decimal? @map("cogs_amount") @db.Decimal(14, 0) // coût des marchandises vendues (marge)
  discountApprovedBy String? @map("discount_approved_by")

  cashSession   CashSession? @relation(fields: [cashSessionId], references: [id])
  installments  SalesInstallment[]
  returns       SalesReturn[]
  @@index([siteId, status])
  @@map("sales_invoices")
}

// ============================================================
// PAIEMENTS (Achats et Ventes)
// ============================================================

enum PaymentDirection {
  IN  // encaissement client
  OUT // décaissement fournisseur
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  MOBILE_MONEY
  CHEQUE
  OTHER
  ORANGE_MONEY
}

model Payment {
  id                String   @id @default(uuid())
  direction         PaymentDirection
  method            PaymentMethod @default(CASH)
  amount            Decimal  @db.Decimal(14, 2)
  paymentDate       DateTime @map("payment_date")
  reference         String?
  salesInvoiceId    String?  @map("sales_invoice_id")
  purchaseInvoiceId String?  @map("purchase_invoice_id")
  createdById       String   @map("created_by")
  createdAt         DateTime @default(now()) @map("created_at")

  salesInvoice      SalesInvoice? @relation(fields: [salesInvoiceId], references: [id])
  purchaseInvoice   PurchaseInvoice? @relation(fields: [purchaseInvoiceId], references: [id])


  cashSessionId     String?  @map("cash_session_id")
  siteId            String?  @map("site_id")
  externalRef       String?  @map("external_ref") // n° de transaction Orange / Mobile Money
  reconciled        Boolean  @default(false)
  clientOpId        String?  @unique @map("client_op_id")

  cashSession       CashSession? @relation(fields: [cashSessionId], references: [id])
  site              Site?    @relation(fields: [siteId], references: [id])
  @@map("payments")
}

// Pannes et immobilisations de véhicules : motif, durée, coût, remise en service
model VehicleDowntime {
  id             String    @id @default(uuid())
  vehicleId      String    @map("vehicle_id")
  siteId         String    @map("site_id")
  category       String    @default("PANNE") // PANNE | ACCIDENT | ENTRETIEN | ADMINISTRATIF | AUTRE
  reason         String    // motif obligatoire
  estimatedCost  Decimal?  @map("estimated_cost") @db.Decimal(14, 2)
  actualCost     Decimal?  @map("actual_cost") @db.Decimal(14, 2)
  startedAt      DateTime  @default(now()) @map("started_at")
  endedAt        DateTime? @map("ended_at")
  resolutionNote String?   @map("resolution_note")
  createdById    String    @map("created_by")
  resolvedById   String?   @map("resolved_by")
  // Déclaration par le chauffeur
  severity       String?
  photoUrls      String[]  @default([]) @map("photo_urls")
  latitude       Float?
  longitude      Float?
  tripId         String?   @map("trip_id")
  clientOpId     String?   @unique @map("client_op_id")

  vehicle        Vehicle   @relation(fields: [vehicleId], references: [id])

  @@index([vehicleId])
  @@index([siteId, startedAt])
  @@map("vehicle_downtimes")
}

// État des besoins : demande adressée à la hiérarchie (réapprovisionnement, pièces à changer, matériel…)
model NeedRequest {
  id            String   @id @default(uuid())
  siteId        String   @map("site_id")
  reference     String   @unique // ex: EB-2026-0001
  title         String
  priority      String   @default("NORMALE") // NORMALE | URGENTE
  status        String   @default("BROUILLON") // BROUILLON | ENVOYE | APPROUVE | REJETE | SATISFAIT
  recipient     String?  // destinataire / hiérarchie
  justification String?
  decisionNote  String?  @map("decision_note")
  createdById   String   @map("created_by")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at")

  lines         NeedRequestLine[]

  @@index([siteId, status])
  @@map("need_requests")
}

model NeedRequestLine {
  id                 String   @id @default(uuid())
  requestId          String   @map("request_id")
  itemId             String?  @map("item_id")
  vehicleId          String?  @map("vehicle_id")
  designation        String
  quantity           Decimal  @db.Decimal(12, 2)
  unit               String?
  estimatedUnitPrice Decimal? @map("estimated_unit_price") @db.Decimal(14, 2)
  note               String?

  request            NeedRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId])
  @@map("need_request_lines")
}

// ============================================================
// TABLEAUX DE BORD PAR DÉPARTEMENT — nouveaux modèles
// (Logistique, Entrepôt, Commercial & Caisse, Flotte, HSE)
// ============================================================

// ---- Logistique & approvisionnements ----------------------

model GoodsReceipt {
  id              String   @id @default(uuid())
  siteId          String   @map("site_id")
  purchaseOrderId String   @map("purchase_order_id")
  reference       String?
  receivedAt      DateTime @default(now()) @map("received_at")
  deliveryNoteNo  String?  @map("delivery_note_no")
  freightCost     Decimal  @default(0) @map("freight_cost") @db.Decimal(14, 0)
  notes           String?
  createdBy       String?  @map("created_by")
  createdAt       DateTime @default(now()) @map("created_at")

  site            Site          @relation(fields: [siteId], references: [id])
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])
  lines           GoodsReceiptLine[]

  @@index([siteId, receivedAt])
  @@map("goods_receipts")
}

model GoodsReceiptLine {
  id                  String  @id @default(uuid())
  goodsReceiptId      String  @map("goods_receipt_id")
  purchaseOrderLineId String? @map("purchase_order_line_id")
  itemId              String  @map("item_id")
  quantityReceived    Decimal @map("quantity_received") @db.Decimal(14, 3)
  quantityAccepted    Decimal @map("quantity_accepted") @db.Decimal(14, 3)
  quantityRejected    Decimal @default(0) @map("quantity_rejected") @db.Decimal(14, 3)
  rejectReason        String? @map("reject_reason")
  lotId               String? @map("lot_id")

  goodsReceipt        GoodsReceipt       @relation(fields: [goodsReceiptId], references: [id], onDelete: Cascade)
  purchaseOrderLine   PurchaseOrderLine? @relation(fields: [purchaseOrderLineId], references: [id])
  item                InventoryItem      @relation(fields: [itemId], references: [id])
  lot                 StockLot?          @relation(fields: [lotId], references: [id])

  @@map("goods_receipt_lines")
}

model StockTransfer {
  id             String   @id @default(uuid())
  reference      String?
  fromSiteId     String   @map("from_site_id")
  toSiteId       String   @map("to_site_id")
  fromLocationId String?  @map("from_location_id")
  toLocationId   String?  @map("to_location_id")
  status         String   @default("IN_TRANSIT") // DRAFT | IN_TRANSIT | RECEIVED | CANCELLED
  shippedAt      DateTime? @map("shipped_at")
  receivedAt     DateTime? @map("received_at")
  createdBy      String?  @map("created_by")
  receivedBy     String?  @map("received_by")
  createdAt      DateTime @default(now()) @map("created_at")

  fromSite       Site     @relation("TransferFromSite", fields: [fromSiteId], references: [id])
  toSite         Site     @relation("TransferToSite", fields: [toSiteId], references: [id])
  lines          StockTransferLine[]
  movements      StockMovement[]

  @@index([status, shippedAt])
  @@map("stock_transfers")
}

model StockTransferLine {
  id         String  @id @default(uuid())
  transferId String  @map("transfer_id")
  itemId     String  @map("item_id")
  lotId      String? @map("lot_id")
  quantity   Decimal @db.Decimal(14, 3)

  transfer   StockTransfer  @relation(fields: [transferId], references: [id], onDelete: Cascade)
  item       InventoryItem  @relation(fields: [itemId], references: [id])

  @@map("stock_transfer_lines")
}

// ---- Entrepôt & stocks ------------------------------------

model StockLocation {
  id       String  @id @default(uuid())
  siteId   String  @map("site_id")
  code     String
  name     String
  zone     String?
  isActive Boolean @default(true) @map("is_active")

  site     Site    @relation(fields: [siteId], references: [id])
  items    InventoryItem[]
  lots     StockLot[]
  movementsFrom StockMovement[] @relation("MovementFromLocation")
  movementsTo   StockMovement[] @relation("MovementToLocation")
  hseIncidents  HseIncident[]
  hseToolboxTalks HseToolboxTalk[]
  hseInspections  HseInspection[]

  @@unique([siteId, code])
  @@map("stock_locations")
}

model StockLot {
  id          String   @id @default(uuid())
  itemId      String   @map("item_id")
  siteId      String   @map("site_id")
  locationId  String?  @map("location_id")
  lotNumber   String   @map("lot_number")
  receivedAt  DateTime @default(now()) @map("received_at")
  expiryDate  DateTime? @map("expiry_date")
  quantity    Decimal  @default(0) @db.Decimal(14, 3)
  unitCost    Decimal  @default(0) @map("unit_cost") @db.Decimal(14, 2)
  createdAt   DateTime @default(now()) @map("created_at")

  item        InventoryItem  @relation(fields: [itemId], references: [id])
  site        Site           @relation(fields: [siteId], references: [id])
  location    StockLocation? @relation(fields: [locationId], references: [id])
  movements   StockMovement[]
  goodsReceiptLines GoodsReceiptLine[]

  @@index([siteId, expiryDate])
  @@index([itemId])
  @@map("stock_lots")
}

// ---- Commercial & caisse ----------------------------------

model CashSession {
  id           String   @id @default(uuid())
  siteId       String   @map("site_id")
  cashierId    String   @map("cashier_id")
  openedAt     DateTime @default(now()) @map("opened_at")
  closedAt     DateTime? @map("closed_at")
  openingFloat Decimal  @default(0) @map("opening_float") @db.Decimal(14, 0)
  countedCash  Decimal? @map("counted_cash") @db.Decimal(14, 0)
  expectedCash Decimal? @map("expected_cash") @db.Decimal(14, 0)
  gapAmount    Decimal? @map("gap_amount") @db.Decimal(14, 0)
  validatedBy  String?  @map("validated_by")
  note         String?

  site         Site     @relation(fields: [siteId], references: [id])
  cashier      User     @relation(fields: [cashierId], references: [id])
  invoices     SalesInvoice[]
  payments     Payment[]
  expenses     CashExpense[]

  @@index([siteId, openedAt])
  @@map("cash_sessions")
}

// Décaissements de caisse (dépenses payées en espèces pendant la session)
model CashExpense {
  id            String   @id @default(uuid())
  cashSessionId String   @map("cash_session_id")
  amount        Decimal  @db.Decimal(14, 0)
  reason        String
  createdBy     String?  @map("created_by")
  createdAt     DateTime @default(now()) @map("created_at")

  cashSession   CashSession @relation(fields: [cashSessionId], references: [id], onDelete: Cascade)

  @@index([cashSessionId])
  @@map("cash_expenses")
}

model SalesInstallment {
  id             String   @id @default(uuid())
  salesInvoiceId String   @map("sales_invoice_id")
  dueDate        DateTime @map("due_date")
  amount         Decimal  @db.Decimal(14, 0)
  amountPaid     Decimal  @default(0) @map("amount_paid") @db.Decimal(14, 0)

  salesInvoice   SalesInvoice @relation(fields: [salesInvoiceId], references: [id], onDelete: Cascade)

  @@index([dueDate])
  @@map("sales_installments")
}

model SalesReturn {
  id             String   @id @default(uuid())
  siteId         String   @map("site_id")
  salesInvoiceId String   @map("sales_invoice_id")
  reference      String?
  reason         String
  totalAmount    Decimal  @map("total_amount") @db.Decimal(14, 0)
  restock        Boolean  @default(true)
  status         String   @default("PENDING") // PENDING | VALIDATED | REJECTED
  createdBy      String?  @map("created_by")
  validatedBy    String?  @map("validated_by")
  createdAt      DateTime @default(now()) @map("created_at")

  site           Site         @relation(fields: [siteId], references: [id])
  salesInvoice   SalesInvoice @relation(fields: [salesInvoiceId], references: [id])
  lines          SalesReturnLine[]

  @@index([siteId, createdAt])
  @@map("sales_returns")
}

model SalesReturnLine {
  id        String  @id @default(uuid())
  returnId  String  @map("return_id")
  itemId    String  @map("item_id")
  quantity  Decimal @db.Decimal(14, 3)
  amount    Decimal @db.Decimal(14, 0)

  salesReturn SalesReturn   @relation(fields: [returnId], references: [id], onDelete: Cascade)
  item        InventoryItem @relation(fields: [itemId], references: [id])

  @@map("sales_return_lines")
}

// ---- HSE ---------------------------------------------------

model HseIncident {
  id              String   @id @default(uuid())
  siteId          String   @map("site_id")
  reference       String?
  occurredAt      DateTime @map("occurred_at")
  zone            String?
  locationId      String?  @map("location_id")
  type            String   // ACCIDENT | NEAR_MISS | DAMAGE | ENVIRONMENT | FIRE | OTHER
  severity        String   // LOW | MEDIUM | HIGH | CRITICAL
  lostTime        Boolean  @default(false) @map("lost_time") // accident avec arrêt
  lostDays        Int      @default(0) @map("lost_days")
  riskCategory    String?  @map("risk_category")
  vehicleId       String?  @map("vehicle_id")
  itemId          String?  @map("item_id")
  description     String
  immediateAction String?  @map("immediate_action")
  rootCause       String?  @map("root_cause")
  status          String   @default("OPEN") // OPEN | INVESTIGATING | CLOSED
  photos          Json?
  reportedBy      String?  @map("reported_by")
  closedBy        String?  @map("closed_by")
  closedAt        DateTime? @map("closed_at")
  clientOpId      String?  @unique @map("client_op_id")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  site            Site           @relation(fields: [siteId], references: [id])
  location        StockLocation? @relation(fields: [locationId], references: [id])
  vehicle         Vehicle?       @relation(fields: [vehicleId], references: [id])
  item            InventoryItem? @relation(fields: [itemId], references: [id])
  persons         HseIncidentPerson[]
  actions         HseCorrectiveAction[]

  @@index([siteId, occurredAt])
  @@map("hse_incidents")
  latitude        Float?
  longitude       Float?
  photoUrls       String[] @default([]) @map("photo_urls")
}

model HseIncidentPerson {
  id         String  @id @default(uuid())
  incidentId String  @map("incident_id")
  userId     String? @map("user_id")
  driverId   String? @map("driver_id")
  fullName   String? @map("full_name")
  injury     String?

  incident   HseIncident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  user       User?       @relation(fields: [userId], references: [id])
  driver     Driver?     @relation(fields: [driverId], references: [id])

  @@map("hse_incident_persons")
}

model HseInspection {
  id          String   @id @default(uuid())
  siteId      String   @map("site_id")
  type        String   // WAREHOUSE | VEHICLE | FIRE_EXTINGUISHER | ZONE
  locationId  String?  @map("location_id")
  vehicleId   String?  @map("vehicle_id")
  inspectedAt DateTime @default(now()) @map("inspected_at")
  inspectorId String?  @map("inspector_id")
  score       Decimal? @db.Decimal(5, 2)
  compliant   Boolean?
  checklist   Json?
  notes       String?

  site        Site           @relation(fields: [siteId], references: [id])
  location    StockLocation? @relation(fields: [locationId], references: [id])
  vehicle     Vehicle?       @relation(fields: [vehicleId], references: [id])
  inspector   User?          @relation("InspectionInspector", fields: [inspectorId], references: [id])
  actions     HseCorrectiveAction[]

  @@map("hse_inspections")
}

model HseCorrectiveAction {
  id            String   @id @default(uuid())
  siteId        String   @map("site_id")
  incidentId    String?  @map("incident_id")
  inspectionId  String?  @map("inspection_id")
  title         String
  responsibleId String?  @map("responsible_id")
  dueDate       DateTime @map("due_date")
  status        String   @default("OPEN") // OPEN | IN_PROGRESS | DONE | OVERDUE
  doneAt        DateTime? @map("done_at")
  createdAt     DateTime @default(now()) @map("created_at")

  site          Site           @relation(fields: [siteId], references: [id])
  incident      HseIncident?   @relation(fields: [incidentId], references: [id])
  inspection    HseInspection? @relation(fields: [inspectionId], references: [id])
  responsible   User?          @relation("ActionResponsible", fields: [responsibleId], references: [id])

  @@index([status, dueDate])
  @@map("hse_corrective_actions")
}

model HseToolboxTalk {
  id            String   @id @default(uuid())
  siteId        String   @map("site_id")
  theme         String
  plannedAt     DateTime @map("planned_at")
  heldAt        DateTime? @map("held_at")
  facilitatorId String?  @map("facilitator_id")
  locationId    String?  @map("location_id")
  status        String   @default("PLANNED") // PLANNED | DONE | CANCELLED
  notes         String?

  site          Site           @relation(fields: [siteId], references: [id])
  facilitator   User?          @relation("TalkFacilitator", fields: [facilitatorId], references: [id])
  location      StockLocation? @relation(fields: [locationId], references: [id])
  attendees     HseToolboxAttendee[]

  @@map("hse_toolbox_talks")
}

model HseToolboxAttendee {
  id           String  @id @default(uuid())
  talkId       String  @map("talk_id")
  userId       String? @map("user_id")
  driverId     String? @map("driver_id")
  fullName     String? @map("full_name")
  signatureUrl String? @map("signature_url")

  talk         HseToolboxTalk @relation(fields: [talkId], references: [id], onDelete: Cascade)
  user         User?          @relation(fields: [userId], references: [id])
  driver       Driver?        @relation(fields: [driverId], references: [id])

  @@map("hse_toolbox_attendees")
}

model PpeIssuance {
  id         String   @id @default(uuid())
  siteId     String   @map("site_id")
  userId     String?  @map("user_id")
  driverId   String?  @map("driver_id")
  ppeType    String   @map("ppe_type") // CASQUE, GILET, CHAUSSURES, GANTS, LUNETTES...
  issuedAt   DateTime @map("issued_at")
  renewalDue DateTime? @map("renewal_due")
  compliant  Boolean  @default(true) // dernier contrôle
  checkedAt  DateTime? @map("checked_at")

  site       Site     @relation(fields: [siteId], references: [id])
  user       User?    @relation(fields: [userId], references: [id])
  driver     Driver?  @relation(fields: [driverId], references: [id])

  @@map("ppe_issuances")
}

model HseTraining {
  id         String   @id @default(uuid())
  userId     String?  @map("user_id")
  driverId   String?  @map("driver_id")
  title      String   // habilitation / formation
  obtainedAt DateTime @map("obtained_at")
  expiresAt  DateTime? @map("expires_at")

  user       User?    @relation(fields: [userId], references: [id])
  driver     Driver?  @relation(fields: [driverId], references: [id])

  @@map("hse_trainings")
}

// Heures travaillées par mois et par site (taux de fréquence des accidents)
model HseWorkedHours {
  id      String   @id @default(uuid())
  siteId  String   @map("site_id")
  period  DateTime @db.Date // 1er jour du mois
  hours   Decimal  @db.Decimal(12, 1)

  site    Site     @relation(fields: [siteId], references: [id])

  @@unique([siteId, period])
  @@map("hse_worked_hours")
}


// ============================================================
// APPLICATION CHAUFFEUR : appareils autorisés et journal de trajet
// ============================================================
// 1 chauffeur = 1 appareil actif. Activation par QR (jeton) ou code OTP à usage unique ; blocage à distance.
model DriverDevice {
  id                  String    @id @default(uuid())
  driverId            String    @map("driver_id")
  userId              String    @map("user_id")
  fingerprint         String?
  model               String?
  os                  String?
  tokenHash           String?   @map("token_hash")
  otpHash             String?   @map("otp_hash")
  activationExpiresAt DateTime? @map("activation_expires_at")
  status              String    @default("PENDING") // PENDING | ACTIVE | BLOCKED | REVOKED
  blockedAt           DateTime? @map("blocked_at")
  blockedBy           String?   @map("blocked_by")
  blockedReason       String?   @map("blocked_reason")
  activatedAt         DateTime? @map("activated_at")
  lastSeenAt          DateTime? @map("last_seen_at")
  createdBy           String?   @map("created_by")
  createdAt           DateTime  @default(now()) @map("created_at")

  @@index([driverId, status])
  @@index([userId, fingerprint])
  @@map("driver_devices")
}

model TripLog {
  id            String   @id @default(uuid())
  tripId        String   @map("trip_id")
  driverId      String   @map("driver_id")
  eventType     String   @map("event_type") // START | PAUSE | RESUME | ARRIVE | INCIDENT | BREAKDOWN | FUEL
  latitude      Float?
  longitude     Float?
  mileage       Int?
  syncedOffline Boolean  @default(false) @map("synced_offline")
  clientOpId    String?  @unique @map("client_op_id")
  occurredAt    DateTime @map("occurred_at")
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([tripId, occurredAt])
  @@map("trip_logs")
}
