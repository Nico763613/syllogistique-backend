# Base de données
DATABASE_URL="postgresql://syllogistique:syllogistique_pwd@localhost:5432/syllogistique?schema=public"

# JWT
JWT_ACCESS_SECRET="change_this_access_secret"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="change_this_refresh_secret"
JWT_REFRESH_EXPIRES_IN="30d"

# Application
# Sites autorisés à appeler l'API (séparés par des virgules). OBLIGATOIRE en production.
CORS_ORIGINS=
# Swagger (/docs) : actif hors production ; mettre true pour l'activer en production
ENABLE_DOCS=false
PORT=3000
NODE_ENV=development

# Tarifs carburant par défaut (GNF/Litre) — modifiables ensuite via /settings
DEFAULT_TRUCK_FUEL_PRICE=10000
DEFAULT_SERVICE_VEHICLE_FUEL_PRICE=12000

# Email (optionnel — sans ces valeurs, l'envoi d'email est simulé/loggé uniquement)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="SYLLOGISTIQUE <no-reply@votre-domaine.com>"
